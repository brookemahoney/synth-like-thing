#ddev-generated
# User-editable Assistant T3 add-on configuration.
# Re-run 'ddev add-on get e0ipso/ddev-assistant-t3' and 'ddev restart' after changing port or version values.
# ASSISTANT_T3_DIRECT_BIND_ADDRESS accepts a comma-separated list of host
# addresses. Add a Tailscale IP to reach T3 from the tailnet, use 0.0.0.0 for
# every interface, or leave it empty to publish nothing outside ddev-router.
ASSISTANT_T3_VERSION=latest
ASSISTANT_T3_HTTP_PORT=
ASSISTANT_T3_HTTPS_PORT=
ASSISTANT_T3_CONTAINER_PORT=3773
ASSISTANT_T3_DIRECT_BIND_ADDRESS=127.0.0.1
ASSISTANT_T3_DIRECT_PORT=
